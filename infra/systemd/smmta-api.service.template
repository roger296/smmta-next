# Systemd unit for the SMMTA-NEXT API.
#
# Runs `tsx src/server.ts` directly (matches the VPS reality on
# striped-acrobats.metalseed.io) so a separate `npm run build` step
# isn't required after every code change.
#
# Tokens replaced by infra/install.sh:
#   __SMMTA_USER__       — Linux user that owns the deploy
#   __SMMTA_HOME__       — that user's home directory
#   __SMMTA_NODE_BIN__   — full path to the node binary (NVM or system)
#
# Reads its environment from <repo>/apps/api/.env (mode 0600), which is
# generated at install time and contains DATABASE_URL, JWT_SECRET,
# COMPANY_ID, etc.

[Unit]
Description=SMMTA-NEXT API (Fastify + Drizzle)
Documentation=https://github.com/roger296/smmta-next
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__SMMTA_USER__
Group=__SMMTA_USER__
WorkingDirectory=__SMMTA_HOME__/smmta-next/apps/api
EnvironmentFile=__SMMTA_HOME__/smmta-next/apps/api/.env
Environment=PATH=__SMMTA_HOME__/.nvm/versions/node/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production

ExecStart=__SMMTA_NODE_BIN__ __SMMTA_HOME__/smmta-next/node_modules/.bin/tsx src/server.ts

Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=smmta-api

[Install]
WantedBy=multi-user.target
