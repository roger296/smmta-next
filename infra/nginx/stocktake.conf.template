# Nginx server block for the standalone stock-take-lite PWA (P26).
# Serves the static Vite build (copied to /var/www/stocktake-web by
# infra/scripts/deploy-stocktake.sh) and proxies /api to the Auto-Stock API.
# Token:
#   __STOCKTAKE_HOST__ — e.g. stocktake.starship.thebigbakes.com

server {
    listen 80;
    listen [::]:80;
    server_name __STOCKTAKE_HOST__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __STOCKTAKE_HOST__;

    # Certbot fills these in:
    # ssl_certificate     /etc/letsencrypt/live/__STOCKTAKE_HOST__/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/__STOCKTAKE_HOST__/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 2m;

    root /var/www/stocktake-web;
    index index.html;

    # API → local Fastify (the same API the rest of Auto-Stock uses).
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;
    }

    # The service worker must never be long-cached, or updates won't land.
    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # SPA fall-through.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-cache hashed Vite assets.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
}
