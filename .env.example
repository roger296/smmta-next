# ============================================================
# New Filament Store — environment template
# Copy to apps/api/.env (and apps/worker/.env) and fill in.
# Only TEST/SANDBOX credentials during the build session.
# ============================================================

# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Database (dev) ---
# Points at the docker-compose Postgres (see docker-compose.yml).
DATABASE_URL=postgresql://smmta:smmta@localhost:5432/smmta_next

# --- Database (integration tests) ---
# A SEPARATE database migrated fresh + truncated between tests. Falls back to
# DATABASE_URL when unset so a plain `docker compose up -d` still runs tests.
TEST_DATABASE_URL=postgresql://smmta:smmta@localhost:5432/filament_test

# --- Auth (existing smmta-next admin JWT) ---
JWT_SECRET=dev-secret-change-in-production

# --- Singleton tenant id (single-tenant per deployment) ---
COMPANY_ID=11111111-1111-4111-8111-111111111111

# --- Luca General Ledger (existing integration) ---
# Luca GL is optional and OFF by default. A GL posting failure rolls back the
# business transaction that triggered it, so enabling this without a reachable
# Luca instance makes stock adjustments and GRNs fail with a 500.
LUCA_ENABLED=false
LUCA_API_BASE_URL=http://localhost:4000
LUCA_API_TIMEOUT_MS=10000

# --- Redis (existing; BullMQ / supplier workers) ---
REDIS_URL=redis://localhost:6379

# --- Storefront internal callback (existing) ---
STORE_BASE_URL=
# Shared secret for API<->storefront internal calls. The API sends it; the
# storefront checks it as ADMIN_API_KEY; the outbox-cron uses it to trigger
# email sending. Empty = back-in-stock AND order-confirmation emails silently
# never send. Generate with: openssl rand -hex 24
STORE_INTERNAL_API_KEY=
# The Clothes Shop's internal origin (e.g. http://store-clothes:3000). Shipped
# emails go to whichever storefront knows the order. Empty skips it.
CLOTHES_STORE_INTERNAL_URL=
# How often the outbox drainer runs, in seconds.
OUTBOX_INTERVAL_SECONDS=60

# --- Auth.js / NextAuth (storefront customer auth, Prompt 3) ---
AUTH_SECRET=dev-authjs-secret-change-in-production
AUTH_URL=http://localhost:3000
# Google OAuth (enabled). Leave blank to fall back to the email/guest tier.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook OAuth (code-complete but feature-flagged OFF).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
AUTH_FACEBOOK_ENABLED=false

# --- Mollie payments (Prompt 6, 13) — TEST key only ---
MOLLIE_API_KEY=test_placeholder
APP_BASE_URL=http://localhost:3000

# --- SendGrid email (Prompt 9) — sandbox only ---
SENDGRID_API_KEY=SG.sandbox_placeholder
SENDGRID_WEBHOOK_KEY=sandbox_webhook_verification_key
# SendGrid Signed Event Webhook: base64 public verification key (enable signing
# in SendGrid → Event Webhook settings and paste the key it shows).
SENDGRID_WEBHOOK_VERIFICATION_KEY=
SENDGRID_FROM_TRANSACTIONAL=sales@cleverdeals.net
SENDGRID_FROM_MARKETING=sales@cleverdeals.net
# Force SendGrid sandbox (no real delivery) regardless of NODE_ENV.
SENDGRID_SANDBOX=true
# Signs one-click unsubscribe URLs.
UNSUBSCRIBE_SECRET=dev-unsubscribe-secret
# Marketing frequency cap + nightly volume.
MARKETING_FREQ_CAP_COUNT=3
MARKETING_FREQ_CAP_DAYS=7
MARKETING_MAX_SENDS_PER_NIGHT=200

# --- OpenRouter LLM (Prompt 8, 9, 11, 12) — low spend cap ---
# Empty key: the storefront chat assistant refuses every message with
# "the assistant is offline" and the API logs a warning on boot. It does
# NOT fall back to a fake model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# Comma-separated, tried in order after OPENROUTER_MODEL. Keep these
# current: a decommissioned model here fails every chat turn.
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.1-8b-instruct
# Per-day spend ceiling in integer micro-USD (1_000_000 = $1.00). Default $2/day.
OPENROUTER_DAILY_CAP_MICROUSD=2000000
# Stage-1 chat classifier. Runs on every user turn, so it wants the
# cheapest model that reliably emits a small JSON object — separate from
# OPENROUTER_MODEL, which answers the turn and is worth paying more for.
OPENROUTER_CLASSIFIER_MODEL=anthropic/claude-3.5-haiku
# Master switch for the classifier. false → every turn goes straight to
# the sales specialist, exactly as chat behaved before the classifier
# existed. Flip this rather than rolling back if classification misbehaves.
CHAT_CLASSIFIER_ENABLED=true

# --- Smooth Parcel shipping labels ---
# OFF by default. The API key comes from the Smooth Parcel account; the
# username and password are that account's login, used to register it and by
# the connection check. LIVE URL by default: a label costs nothing unless the
# parcel is actually sent (BETA is https://api-beta.smoothparcel.com).
SMOOTH_PARCEL_ENABLED=false
SMOOTH_PARCEL_API_BASE_URL=https://api.smoothparcel.com
SMOOTH_PARCEL_API_KEY=
SMOOTH_PARCEL_USERNAME=
SMOOTH_PARCEL_PASSWORD=
SMOOTH_PARCEL_TIMEOUT_MS=15000
SMOOTH_PARCEL_SENDER_NAME=
# Smooth Parcel requires a phone and email on every shipment; these are the
# placeholders sent when the customer gave none.
SMOOTH_PARCEL_DEFAULT_PHONE=
SMOOTH_PARCEL_FALLBACK_EMAIL=
# Per spool, used when a product has no weight recorded. Smooth Parcel
# re-weighs every parcel, so this only needs to be a fair estimate.
SMOOTH_PARCEL_DEFAULT_WEIGHT_KG=1.3
# Buy the label as soon as an order is fully allocated, whatever route it came
# in by (worker). OFF: storefront orders get their label on payment. ON suits a
# business whose orders arrive by file or API feed and are never paid here.
SHIPPING_LABEL_ON_ALLOCATION=false
# Label PDFs. PRIVATE — they carry customer names and addresses, so this must
# never be a directory the static /uploads route serves.
LABELS_DIR=./labels

# --- Worker / pg-boss (Prompt 1) ---
# pg-boss runs inside the same Postgres, in its own schema.
PGBOSS_SCHEMA=pgboss
# Optional worker health HTTP port (0 disables the server).
WORKER_HEALTH_PORT=0

# --- Drop-ship suppliers (worker) ---
# Poll supplier stock and cost prices, each supplier on its own interval.
SUPPLIER_POLL_ENABLED=false
# Send paid orders' drop-ship lines to the supplier. These are REAL orders:
# leave off until a test order has been checked end to end.
SUPPLIER_ORDER_PLACING_ENABLED=false
# Emailed when a supplier order fails and needs a person.
SUPPLIER_ORDER_ALERT_EMAIL=roger@etailsupport.com
# The contact email given to suppliers on each order (ours, not the customer's).
SUPPLIER_ORDER_CONTACT_EMAIL=sales@cleverdeals.net
# A supplier's account number, account email and delivery-method code are not
# settings: they live on the supplier record, set on the admin Drop-ship tab.

# --- Google Merchant Centre product feeds (worker) ---
# OFF by default. When on, the worker writes one feed file per shop each night
# and Google fetches them; the directory must be one the API serves.
GOOGLE_FEED_ENABLED=false
# channel-slug=https://origin pairs, comma separated.
GOOGLE_FEED_SHOPS=
GOOGLE_FEED_DIR=/app/uploads/feeds
GOOGLE_FEED_DEFAULT_SHIPPING_GBP=7.00

# --- Observability (Prompt 15) ---
SENTRY_DSN=
SENTRY_ENABLED=false

# --- Backups (Prompt 15) — rclone/B2 target ---
BACKUP_RCLONE_REMOTE=
