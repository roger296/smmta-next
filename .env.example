# ============================================================
# New Filament Store — environment template
# Copy to apps/api/.env (and apps/worker/.env) and fill in.
# Only TEST/SANDBOX credentials during the build session.
# ============================================================

# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Database (dev) ---
# Points at the docker-compose Postgres (see docker-compose.yml).
DATABASE_URL=postgresql://smmta:smmta@localhost:5432/smmta_next

# --- Database (integration tests) ---
# A SEPARATE database migrated fresh + truncated between tests. Falls back to
# DATABASE_URL when unset so a plain `docker compose up -d` still runs tests.
TEST_DATABASE_URL=postgresql://smmta:smmta@localhost:5432/filament_test

# --- Auth (existing smmta-next admin JWT) ---
JWT_SECRET=dev-secret-change-in-production

# --- Singleton tenant id (single-tenant per deployment) ---
COMPANY_ID=11111111-1111-4111-8111-111111111111

# --- Auth.js / NextAuth (storefront customer auth, Prompt 3) ---
AUTH_SECRET=dev-authjs-secret-change-in-production
AUTH_URL=http://localhost:3000
# Google OAuth (enabled). Leave blank to fall back to the email/guest tier.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook OAuth (code-complete but feature-flagged OFF).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
AUTH_FACEBOOK_ENABLED=false

# --- Mollie payments (Prompt 6, 13) — TEST key only ---
MOLLIE_API_KEY=test_placeholder
APP_BASE_URL=http://localhost:3000

# --- SendGrid email (Prompt 9) — sandbox only ---
SENDGRID_API_KEY=SG.sandbox_placeholder
SENDGRID_WEBHOOK_KEY=sandbox_webhook_verification_key
SENDGRID_FROM_TRANSACTIONAL=orders@filament.shop.cleverdeals.net
SENDGRID_FROM_MARKETING=hello@filament.shop.cleverdeals.net
# Force SendGrid sandbox (no real delivery) regardless of NODE_ENV.
SENDGRID_SANDBOX=true

# --- OpenRouter LLM (Prompt 8, 9, 11, 12) — low spend cap ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_FALLBACK_MODELS=google/gemini-flash-1.5
# Per-day spend ceiling in integer micro-USD (1_000_000 = $1.00). Default $2/day.
OPENROUTER_DAILY_CAP_MICROUSD=2000000

# --- Worker / pg-boss (Prompt 1) ---
# pg-boss runs inside the same Postgres, in its own schema.
PGBOSS_SCHEMA=pgboss

# --- Observability (Prompt 15) ---
SENTRY_DSN=
SENTRY_ENABLED=false

# --- Backups (Prompt 15) — rclone/B2 target ---
BACKUP_RCLONE_REMOTE=
